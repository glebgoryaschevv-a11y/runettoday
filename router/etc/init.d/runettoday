#!/bin/sh /etc/rc.common

START=95
STOP=10

USE_PROCD=1
PROG=/usr/bin/runettoday

start_service() {
	. /lib/functions.sh
	config_load runettoday

	local enabled
	config_get enabled main enabled "1"
	[ "$enabled" = "1" ] || return 0

	local tel_int hb_int
	config_get tel_int main telemetry_interval "900"
	config_get hb_int  main heartbeat_interval "300"

	# Ставим cron-задачи, если их ещё нет
	CRON_FILE=/etc/crontabs/root
	touch "$CRON_FILE"

	# Метка для удаления
	MARK="# runettoday-managed"

	# Убираем старые строки
	sed -i "/$MARK/d" "$CRON_FILE"

	# heartbeat: каждые N секунд → пересчёт в минуты для cron
	hb_min=$((hb_int / 60))
	[ "$hb_min" -lt 1 ] && hb_min=5

	# telemetry: интервал в минутах
	tel_min=$((tel_int / 60))
	[ "$tel_min" -lt 1 ] && tel_min=15

	echo "*/$hb_min * * * * $PROG heartbeat >/dev/null 2>&1 $MARK" >> "$CRON_FILE"
	echo "*/$tel_min * * * * $PROG telemetry >/dev/null 2>&1 $MARK" >> "$CRON_FILE"

	/etc/init.d/cron restart 2>/dev/null || true
}

stop_service() {
	CRON_FILE=/etc/crontabs/root
	MARK="# runettoday-managed"
	sed -i "/$MARK/d" "$CRON_FILE" 2>/dev/null
	/etc/init.d/cron restart 2>/dev/null || true
}
